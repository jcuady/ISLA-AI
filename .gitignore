# Isla AI — ignore rules

# --- model weights and binaries: NEVER commit. Fetched by models/download_models.py ---
models/weights/
models/llamacpp/

# --- corpus raw source documents: refetched by corpus/fetch_corpus.py ---
# The processed chunks + index ARE committed so the demo works without a network.
corpus/raw/*.pdf
corpus/raw/*.html
corpus/processed/embeddings.npy
# Pooling-mode-scoped embedding caches (embeddings.cls.npy, ...). Regenerated
# from the corpus whenever the encoder or pooling changes.
corpus/processed/embeddings.*.npy

# --- runtime state ---
data/
*.log

# --- Python ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node ---
node_modules/
apps/web/dist/

# --- UI verification output (screenshots from apps/web/verify-ui.mjs) ---
apps/web/.verify/
apps/web/.verify-shots/

# --- raw image-generation sources from branding/asset-manifest.json ---
# branding/_gen/ holds ~15 MB of 4K intermediates. They are reproducible from
# the recorded prompts; the rekeyed, resized masters under branding/ are tracked.
branding/_gen/

# --- throwaway renders from scripts/process_isla_logo.py ---
branding/_*.png

# --- local model download artefacts ---
*.part

# --- editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
.playwright-mcp/